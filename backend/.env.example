# App Config
PROJECT_NAME="MomPulse API"
DEBUG=True
ENVIRONMENT="development"

# Telegram Bot Token (from @BotFather)
BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Database Configuration (PostgreSQL Async via asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/mompulse_db"

# CORS configuration (comma separated origins or * in dev)
CORS_ORIGINS=["*"]

# Telegram initData check bypass for local dev/testing without Telegram client
ALLOW_DEV_AUTH_BYPASS=True
